{
  "name": "zullumap-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run build -w @zullumap/viewer",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p packages/viewer --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
